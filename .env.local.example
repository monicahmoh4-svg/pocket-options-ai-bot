# Pocket Options Configuration
# Get your auth token from Pocket Options web platform
POCKET_OPTIONS_AUTH_TOKEN=your_auth_token_here

# Environment: 'real' or 'demo'
POCKET_OPTIONS_ENV=demo

# WebSocket URLs
POCKET_OPTIONS_WS_URL=wss://api-l5.pocketoption.com

# Optional: Google Gemini AI for enhanced signals
GOOGLE_AI_API_KEY=your_google_ai_key_here
